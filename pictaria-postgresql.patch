new file mode 100644
index 0000000..9fbf53e
--- /dev/null
+++ b/src/database/postgres-functions.sql
@@ -0,0 +1,66 @@
+CREATE OR REPLACE FUNCTION pictaria_json_value(value text, path text)
+RETURNS jsonb LANGUAGE sql IMMUTABLE STRICT SET search_path FROM CURRENT AS $$
+  SELECT value::jsonb #> string_to_array(substr(path, 3), '.')
+$$;
+
+CREATE OR REPLACE FUNCTION json_extract(value text, path text)
+RETURNS text LANGUAGE sql IMMUTABLE STRICT SET search_path FROM CURRENT AS $$
+  SELECT pictaria_json_value(value, path) #>> '{}'
+$$;
+
+CREATE OR REPLACE FUNCTION pictaria_json_number(value text, path text)
+RETURNS bigint LANGUAGE sql IMMUTABLE STRICT SET search_path FROM CURRENT AS $$
+  SELECT CASE jsonb_typeof(item)
+    WHEN 'boolean' THEN CASE WHEN item = 'true'::jsonb THEN 1 ELSE 0 END
+    WHEN 'number' THEN (item #>> '{}')::numeric::bigint
+    END
+  FROM pictaria_json_value(value, path) item
+$$;
+
+CREATE OR REPLACE FUNCTION json_type(value text, path text)
+RETURNS text LANGUAGE sql IMMUTABLE STRICT SET search_path FROM CURRENT AS $$
+  SELECT CASE jsonb_typeof(item)
+    WHEN 'boolean' THEN item #>> '{}'
+    WHEN 'number' THEN CASE WHEN (item #>> '{}') ~ '^-?[0-9]+$' THEN 'integer' ELSE 'real' END
+    WHEN 'string' THEN 'text'
+    ELSE jsonb_typeof(item) END
+  FROM pictaria_json_value(value, path) item
+$$;
+
+CREATE OR REPLACE FUNCTION json_valid(value text)
+RETURNS boolean LANGUAGE plpgsql IMMUTABLE STRICT SET search_path FROM CURRENT AS $$
+BEGIN
+  PERFORM value::jsonb;
+  RETURN true;
+EXCEPTION WHEN data_exception THEN
+  RETURN false;
+END
+$$;
+
+CREATE OR REPLACE FUNCTION json_set(value text, path text, replacement bigint)
+RETURNS text LANGUAGE sql IMMUTABLE STRICT SET search_path FROM CURRENT AS $$
+  SELECT jsonb_set(value::jsonb, string_to_array(substr(path, 3), '.'), to_jsonb(replacement))::text
+$$;
+
+CREATE OR REPLACE FUNCTION julianday(value text)
+RETURNS double precision LANGUAGE plpgsql IMMUTABLE STRICT
+SET TimeZone = 'UTC' SET DateStyle = 'ISO, YMD' AS $$
+BEGIN
+  RETURN extract(epoch FROM (value::timestamptz)) / 86400 + 2440587.5;
+EXCEPTION WHEN data_exception THEN
+  RETURN NULL;
+END
+$$;
+
+CREATE OR REPLACE FUNCTION strftime(format text, value text)
+RETURNS text LANGUAGE plpgsql IMMUTABLE STRICT SET DateStyle = 'ISO, YMD' AS $$
+BEGIN
+  IF format <> '%Y-%m-%d' OR value !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN
+    RETURN NULL;
+  END IF;
+  RETURN to_char(value::date, 'YYYY-MM-DD');
+EXCEPTION WHEN data_exception THEN
+  RETURN NULL;
+END
+$$;
+
diff --git a/src/database/postgres-layout.mjs b/src/database/postgres-layout.mjs
new file mode 100644
index 0000000..b2b4f58
--- /dev/null
+++ b/src/database/postgres-layout.mjs
@@ -0,0 +1,30 @@
+export const POSTGRES_OWNER_LOCK = '78097489725420641';
+
+export const POSTGRES_STORES = [
+  { role: 'enrichment.sqlite', schema: 'pictaria_enrich', required: ['assets', 'processing_runs', 'asset_tags', 'pictaria_schema_version'] },
+  { role: 'frame.db', schema: 'pictaria_frame', required: ['asset_displays', 'voice_command_stats'] },
+  { role: 'insights.sqlite', schema: 'pictaria_insights', required: ['swept_assets', 'pictaria_schema_version'] },
+];
+
+export function postgresOptions(config, store) {
+  return config.postgresUrl ? { url: config.postgresUrl, schema: `pictaria_${store}` } : undefined;
+}
+
+export function postgresPersistentTargets(owner) {
+  return POSTGRES_STORES.map(({ role, schema, required }) => ({
+    role,
+    path: `PostgreSQL schema ${schema}`,
+    kind: 'postgres',
+    inspect() {
+      const [{ present }] = owner.request('native', `
+        SELECT count(*) = cardinality($2::text[]) AS present
+        FROM information_schema.tables
+        WHERE table_schema = $1 AND table_name = ANY($2::text[])
+      `, [schema, required]);
+      return present ? { valid: true } : {
+        valid: false,
+        reason: 'required PostgreSQL tables are missing. Import the SQLite databases or restore PostgreSQL before restarting',
+      };
+    },
+  }));
+}
diff --git a/src/database/postgres-sql.mjs b/src/database/postgres-sql.mjs
new file mode 100644
index 0000000..a1d13e2
--- /dev/null
+++ b/src/database/postgres-sql.mjs
@@ -0,0 +1,86 @@
+// The repositories share SQL with SQLite. Keep the dialect differences here,
+// while leaving storage algorithms, transaction boundaries and bindings in
+// the repositories. All input is repository SQL. User values stay parameters.
+const TOKEN = /'(?:''|[^'])*'|"(?:""|[^"])*"|--[^\n]*|\/\*[\s\S]*?\*\/|[a-z_][\w]*|[^\s]|\s+/gi;
+
+function tokens(sql) {
+  return [...sql.matchAll(TOKEN)].map(([token]) => token);
+}
+
+export function statements(sql) {
+  const result = [];
+  let statement = '';
+  for (const token of tokens(sql)) {
+    if (token === ';') {
+      if (statement.trim()) result.push(statement.trim());
+      statement = '';
+    } else if (!token.startsWith('--') && !token.startsWith('/*')) {
+      statement += token;
+    }
+  }
+  if (statement.trim()) result.push(statement.trim());
+  return result;
+}
+
+function translateFunctions(sql) {
+  const parts = tokens(sql);
+  const calls = [];
+  let last = -1;
+  for (const [index, token] of parts.entries()) {
+    if (!token.trim()) continue;
+    if (token === '(') calls.push(last);
+    if (token === ')') {
+      const call = calls.pop();
+      if (/^json_object$/i.test(parts[call])) {
+        parts[call] = 'json_build_object';
+        parts[index] += '::text';
+      }
+    }
+    if (token === ',') {
+      const call = calls.at(-1);
+      if (/^min$/i.test(parts[call])) parts[call] = 'LEAST';
+      if (/^max$/i.test(parts[call])) parts[call] = 'GREATEST';
+    }
+    last = index;
+  }
+  return parts.join('');
+}
+
+export function postgresSql(sql) {
+  const columns = /^(?:SELECT name FROM pragma_table_info\(([^)]+)\)|PRAGMA table_info\((\w+)\))$/i.exec(sql);
+  if (columns) {
+    sql = 'SELECT column_name AS name FROM information_schema.columns '
+      + `WHERE table_schema = current_schema() AND table_name = ${columns[1] ?? `'${columns[2]}'`} ORDER BY ordinal_position`;
+  }
+  sql = sql
+    .replace(/\bsqlite_master WHERE type = 'table'/gi, "information_schema.tables WHERE table_schema = current_schema() AND table_type = 'BASE TABLE' AND table_name <> 'pictaria_schema_version'")
+    .replace(/(table_type = 'BASE TABLE' AND table_name <> 'pictaria_schema_version') AND name =/gi, '$1 AND table_name =')
+    .replace(/^BEGIN (IMMEDIATE|EXCLUSIVE)$/i, 'BEGIN')
+    .replace(/\bINTEGER PRIMARY KEY AUTOINCREMENT\b/gi, 'BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY')
+    .replace(/\bWITHOUT ROWID\b/gi, '')
+    .replace(/\s+INDEXED BY \w+/gi, '')
+    .replace(/\bCAST\(([\w.]+) AS BLOB\)/gi, "convert_to($1::text, 'UTF8')")
+    .replace(/\btypeof\(([\w.]+)\)/gi, "(CASE WHEN $1 IS NULL THEN 'null' WHEN pg_typeof($1) = 'bigint'::regtype THEN 'integer' ELSE 'text' END)")
+    .replace(/\bjson_extract\(([^,]+),\s*('(\$\.(?:[\w.]+))')\)/gi, (call, source, path, key) =>
+      /(?:\.expiresAt|\.has_people|\.preparationFailures|\.formatVersion|\.contractVersion)$/.test(key)
+        && !key.includes('.properties.') ? `pictaria_json_number(${source}, ${path})` : call)
+    .replace(/\bjson_array_length\(([\w.]+)\)/gi, 'json_array_length($1::json)')
+    .replace(/\bjson_each\(([^)]+)\)/gi, 'json_array_elements_text($1::json)')
+    .replace(/\bprintf\('%020d', (\w+)\)/gi, "lpad($1::text, 20, '0')")
+    .replace(/\b([\w.]+) COLLATE NOCASE\b/gi, 'lower($1)')
+    .replace(/\bIS (NOT )?(?=[a-z_]+\.)/gi, (_, not) => not ? 'IS DISTINCT FROM ' : 'IS NOT DISTINCT FROM ')
+    .replace(/\bCASE WHEN \? THEN\b/gi, 'CASE WHEN ?::bigint <> 0 THEN')
+    .replace(/\bWHERE 0\b/gi, 'WHERE FALSE')
+    .replace(/\b(key) (NOT )?GLOB (\?|'[^']*\*')/gi, (_, key, not, pattern) =>
+      `starts_with(${key}, left(${pattern}::text, -1)) IS ${not ? 'FALSE' : 'TRUE'}`)
+    .replace(/\bSELECT rowid,/gi, 'SELECT ctid AS rowid,')
+    .replace(/(?<!AS )\browid\b/gi, 'ctid')
+    .replace(/\bCAST\(([^()]+) AS REAL\)/gi, 'CAST($1 AS DOUBLE PRECISION)')
+    .replace(/\b(INTEGER|REAL|BLOB)(?=\s*(?:,|\)|NOT NULL|DEFAULT|PRIMARY KEY|CHECK|REFERENCES))/gi, (type) =>
+      ({ INTEGER: 'BIGINT', REAL: 'DOUBLE PRECISION', BLOB: 'BYTEA' })[type.toUpperCase()]);
+  let parameter = 0;
+  return tokens(translateFunctions(sql)).map((token) => {
+    if (token === '?') return `$${++parameter}`;
+    return token;
+  }).join('');
+}
diff --git a/src/database/postgres-worker.mjs b/src/database/postgres-worker.mjs
new file mode 100644
index 0000000..f5fc77a
--- /dev/null
+++ b/src/database/postgres-worker.mjs
@@ -0,0 +1,158 @@
+import { readFileSync } from 'node:fs';
+import { parentPort, workerData } from 'node:worker_threads';
+import pg from 'pg';
+import { postgresSql, statements } from './postgres-sql.mjs';
+
+const { port, signal, url, schema, readOnly } = workerData;
+const client = new pg.Client({
+  connectionString: url,
+  connectionTimeoutMillis: 5_000,
+  keepAlive: true,
+  keepAliveInitialDelayMillis: 5_000,
+  statement_timeout: 30_000,
+  lock_timeout: 5_000,
+  application_name: 'pictaria-server',
+});
+pg.types.setTypeParser(20, Number);
+pg.types.setTypeParser(1700, Number);
+client.on('error', () => parentPort.postMessage('disconnected'));
+
+const tableDefinitions = new Map();
+const compiledStatements = new Map();
+const IDENTITY_TABLES = new Set([
+  'processing_runs', 'manual_overrides', 'pending_sync_jobs', 'enrich_queue', 'job_runs',
+  'activity_log', 'enrich_timing_runs', 'enrich_photo_executions', 'enrich_provider_attempts', 'embedding_spaces',
+]);
+
+async function upsert(sql) {
+  const match = /^INSERT OR (IGNORE|REPLACE) INTO\s+(\w+)\s*(?:\(([^)]+)\))?/i.exec(sql);
+  if (!match) return sql;
+  const [, policy, table, explicitColumns] = match;
+  const insert = sql.replace(/^INSERT OR (?:IGNORE|REPLACE)/i, 'INSERT');
+  if (policy.toUpperCase() === 'IGNORE') return insert + ' ON CONFLICT DO NOTHING';
+
+  if (!tableDefinitions.has(table)) {
+    const { rows } = await client.query(`
+      SELECT a.attname AS name, EXISTS (
+        SELECT FROM pg_index i
+        WHERE i.indrelid = a.attrelid AND i.indisprimary AND a.attnum = ANY(i.indkey)
+      ) AS primary_key
+      FROM pg_attribute a
+      WHERE a.attrelid = $1::regclass AND a.attnum > 0 AND NOT a.attisdropped
+      ORDER BY a.attnum
+    `, [table]);
+    tableDefinitions.set(table, rows);
+  }
+  const definition = tableDefinitions.get(table);
+  const keys = definition.filter((row) => row.primary_key).map((row) => row.name);
+  if (!keys.length) throw new Error(`Missing primary key for PostgreSQL upsert on ${table}.`);
+  const columns = explicitColumns ? explicitColumns.split(',').map((name) => name.trim()) : definition.map((row) => row.name);
+  const updates = columns.filter((name) => !keys.includes(name)).map((name) => `${name}=excluded.${name}`);
+  return `${insert} ON CONFLICT (${keys.join(', ')}) DO ${updates.length ? `UPDATE SET ${updates.join(', ')}` : 'NOTHING'}`;
+}
+
+let outerSavepoint;
+
+async function executeSchema(sql) {
+  // Trigger bodies contain semicolons and need a PostgreSQL trigger function.
+  // Use one converter for the small, uniform AFTER triggers in the schemas.
+  const triggers = new Map();
+  sql = sql.replace(/CREATE TRIGGER (?:IF NOT EXISTS )?(\w+)\s+AFTER (INSERT|UPDATE|DELETE) ON (\w+)(?:\s+WHEN ([\s\S]*?))?\s+BEGIN\s+([\s\S]*?)\s+END\s*;/gi,
+    (_, name, event, table, condition, body) => {
+      triggers.set(name, { event, table, condition, body });
+      return `PICTARIA_TRIGGER ${name};`;
+    });
+  for (const statement of statements(sql)) {
+    if (/^DROP TRIGGER IF EXISTS /i.test(statement)) continue;
+    if (statement.startsWith('PICTARIA_TRIGGER ')) {
+      const name = statement.slice('PICTARIA_TRIGGER '.length);
+      const { event, table, condition, body } = triggers.get(name);
+      const when = condition && condition !== '1' ? condition.replace(/\|\| '0'/g, 'FALSE') : null;
+      const commands = [];
+      for (const item of statements(body)) commands.push(postgresSql(await upsert(item)));
+      await client.query(`
+        CREATE OR REPLACE FUNCTION ${name}() RETURNS trigger LANGUAGE plpgsql
+        SET search_path TO ${schema}, pg_catalog AS $trigger$
+        BEGIN
+          ${when ? `IF ${postgresSql(when)} THEN` : ''}
+          ${commands.join(';\n')};
+          ${when ? 'END IF;' : ''}
+          RETURN NULL;
+        END
+        $trigger$;
+        DROP TRIGGER IF EXISTS ${name} ON ${table};
+        CREATE TRIGGER ${name} AFTER ${event} ON ${table}
+          FOR EACH ROW EXECUTE FUNCTION ${name}();
+      `);
+    } else {
+      const savepoint = /^SAVEPOINT (\w+)$/i.exec(statement)?.[1];
+      if (savepoint && client.getTransactionStatus() === 'I') {
+        await client.query('BEGIN');
+        outerSavepoint = savepoint;
+      }
+      await client.query(postgresSql(await upsert(statement)));
+      if (outerSavepoint && statement.toLowerCase() === `release ${outerSavepoint}`.toLowerCase()) {
+        outerSavepoint = undefined;
+        await client.query('COMMIT');
+      }
+    }
+  }
+}
+
+async function request({ operation, sql, values }) {
+  if (operation === 'open') {
+    try {
+      await client.connect();
+    } catch {
+      throw new Error('Cannot connect to PostgreSQL. Check PICTARIA_DATABASE_URL and database permissions.');
+    }
+    if (!readOnly) await client.query(`CREATE SCHEMA IF NOT EXISTS ${schema}`);
+    await client.query(`SET search_path TO ${schema}, pg_catalog; SET TIME ZONE 'UTC'; SET DateStyle TO 'ISO, YMD'`);
+    if (readOnly) await client.query('SET default_transaction_read_only = on; SET default_transaction_isolation = \'repeatable read\'');
+    return;
+  }
+  if (operation === 'close') return client.end();
+  if (operation === 'functions') {
+    return client.query(readFileSync(new URL('./postgres-functions.sql', import.meta.url), 'utf8')).then(() => undefined);
+  }
+  if (operation === 'exec') return executeSchema(sql);
+  if (operation === 'native') return (await client.query(sql, values)).rows;
+  if (operation === 'declare') {
+    const [name, ...parameters] = values;
+    const query = postgresSql(statements(sql).join(';'));
+    await client.query(`DECLARE ${name} NO SCROLL CURSOR FOR ${query}`, parameters);
+    return;
+  }
+  const key = `${operation}: ${sql}`;
+  let query = compiledStatements.get(key);
+  if (!query) {
+    query = postgresSql(await upsert(statements(sql).join(';')));
+    const table = /^INSERT INTO\s+(\w+)/i.exec(query)?.[1];
+    if (operation === 'run' && IDENTITY_TABLES.has(table) && !/\bRETURNING\b/i.test(query)) {
+      query += ' RETURNING id';
+    }
+    if (compiledStatements.size >= 500) compiledStatements.clear();
+    compiledStatements.set(key, query);
+  }
+  const result = await client.query(query, values.map((value) =>
+    value instanceof Uint8Array ? Buffer.from(value) : value));
+  if (operation === 'run') return { changes: result.rowCount, lastInsertRowid: result.rows[0]?.id ?? 0 };
+  if (operation === 'get') return result.rows[0];
+  return result.rows;
+}
+
+port.on('message', async (message) => {
+  try {
+    port.postMessage({ result: await request(message) });
+  } catch (error) {
+    // Server details may include a bound value. Preserve SQLSTATE for callers.
+    const message = error.code === '23505' ? 'PostgreSQL unique constraint failed.'
+      : error.code === '23503' ? 'PostgreSQL foreign-key constraint failed.'
+      : error.code === '23514' ? 'PostgreSQL check constraint failed.'
+      : error.message;
+    port.postMessage({ error: { message, code: error.code } });
+  } finally {
+    Atomics.store(signal, 0, 1);
+    Atomics.notify(signal, 0);
+  }
+});
diff --git a/src/database/postgres.mjs b/src/database/postgres.mjs
new file mode 100644
index 0000000..d226467
--- /dev/null
+++ b/src/database/postgres.mjs
@@ -0,0 +1,103 @@
+import { MessageChannel, receiveMessageOnPort, Worker } from 'node:worker_threads';
+
+const TIMEOUT_MS = 35_000;
+
+// The repositories use synchronous transactions. A dedicated connection in a
+// worker keeps their transaction boundaries intact while PostgreSQL network
+// I/O is serviced on the worker's event loop.
+export class PostgresDatabase {
+  constructor({ url, schema }, { readOnly = false, onDisconnect } = {}) {
+    if (!['pictaria_enrich', 'pictaria_frame', 'pictaria_insights'].includes(schema)) {
+      throw new Error('Invalid Pictaria PostgreSQL schema.');
+    }
+    this.dialect = 'postgres';
+    this.cursorId = 0;
+    this.signal = new Int32Array(new SharedArrayBuffer(4));
+    const { port1, port2 } = new MessageChannel();
+    this.port = port1;
+    this.worker = new Worker(new URL('./postgres-worker.mjs', import.meta.url), {
+      workerData: { url, schema, readOnly, signal: this.signal, port: port2 },
+      transferList: [port2],
+      execArgv: [],
+    });
+    const disconnected = () => {
+      if (this.closed) return;
+      this.dispose();
+      onDisconnect?.();
+    };
+    this.worker.on('error', disconnected);
+    this.worker.on('exit', disconnected);
+    this.worker.on('message', disconnected);
+    this.worker.unref();
+    this.port.unref();
+    try {
+      this.request('open');
+    } catch (error) {
+      this.dispose();
+      throw error;
+    }
+  }
+
+  request(operation, sql, values) {
+    if (this.closed) throw new Error('PostgreSQL connection is closed.');
+    Atomics.store(this.signal, 0, 0);
+    this.port.postMessage({ operation, sql, values });
+    if (Atomics.wait(this.signal, 0, 0, TIMEOUT_MS) === 'timed-out') {
+      this.dispose();
+      throw new Error('PostgreSQL connection did not respond before the deadline.');
+    }
+    const response = receiveMessageOnPort(this.port)?.message;
+    if (!response) {
+      this.dispose();
+      throw new Error('PostgreSQL worker returned no response.');
+    }
+    const { result, error } = response;
+    if (error) throw Object.assign(new Error(error.message), { code: error.code });
+    return result;
+  }
+
+  exec(sql) {
+    this.request('exec', sql);
+  }
+
+  prepare(sql) {
+    return {
+      all: (...values) => this.request('all', sql, values),
+      iterate: (...values) => this.iterate(sql, values),
+      get: (...values) => this.request('get', sql, values),
+      run: (...values) => this.request('run', sql, values),
+    };
+  }
+
+  *iterate(sql, values) {
+    // Both repository callers already own a transaction (startup
+    // reconciliation or a repeatable-read grouping snapshot).
+    const name = `pictaria_cursor_${++this.cursorId}`;
+    this.request('declare', sql, [name, ...values]);
+    try {
+      for (;;) {
+        const rows = this.request('native', `FETCH 128 FROM ${name}`);
+        yield* rows;
+        if (rows.length < 128) break;
+      }
+    } finally {
+      this.request('native', `CLOSE ${name}`);
+    }
+  }
+
+  close() {
+    if (this.closed) return;
+    try {
+      this.request('close');
+    } finally {
+      this.dispose();
+    }
+  }
+
+  dispose() {
+    if (this.closed) return;
+    this.closed = true;
+    this.port.close();
+    void this.worker.terminate();
+  }
+}
